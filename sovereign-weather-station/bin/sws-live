#!/usr/bin/env python3
"""sws-live: print a reading every two seconds until you press Ctrl-C.

For the workshop table. The logger keeps its five minute rhythm; this just
lets a student breathe on the sensor and watch the number move.
"""
import os, sys, time
sys.path.insert(0, "/opt/sws/station")
from station import find_bus
from bme280 import BME280

n, bus, addr = find_bus()
s = BME280(bus, addr)
print("i2c-%d 0x%02X  %s\n" % (n, addr, "BME280" if s.has_humidity else "BMP280 (no humidity)"))
try:
    while True:
        t, p, h = s.read()
        print("%s  %6.2f C  %7.1f hPa  %s" % (
            time.strftime("%H:%M:%S"), t, p, "  --  %RH" if h is None else "%5.1f %%RH" % h))
        time.sleep(2)
except KeyboardInterrupt:
    print()
